# Copy to .env and fill in. Sources whose token is missing are skipped with a message.

# USGS Water Data API key (free): https://api.waterdata.usgs.gov/signup
USGS_API_KEY=

# NOAA NCEI Climate Data Online token (free): https://www.ncdc.noaa.gov/cdo-web/token
NOAA_NCEI_TOKEN=

# NASA Earthdata login (free): https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# OpenET API key: https://account.etdata.org
OPENET_API_KEY=

# Synoptic Data (MesoWest/RAWS) token: https://customer.synopticdata.com
SYNOPTIC_TOKEN=

# USDA NASS Quick Stats key (free): https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# Contact email placed in the User-Agent header so data providers can reach you
NMWATER_CONTACT=you@example.org

# Where data lands (default: ./data)
NMWATER_DATA_DIR=

# Colorado DWR / CDSS key (free, optional): raises the daily data quota that otherwise
# returns 403 "Exceeded Daily Data Limit". Request at https://dwr.state.co.us/rest/get/help
CODWR_API_KEY=
