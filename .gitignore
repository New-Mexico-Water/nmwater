# Downloaded data and derived stores (rebuildable; hundreds of GB)
data/

# Credentials and local environment
.env
.env.local
*.pem
*.key
.netrc

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Generated reports: every CSV table the code writes for reading (update log, reservoir tables, data dictionary tables) goes in reports/ and none is committed.
# Hand-written inputs live in catalog/ and are committed.
reports/*

# Run artifacts
docs/qa/*
!docs/qa/report.md
*.log
*.duckdb
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Editor and OS
.DS_Store
.idea/
.vscode/
*.swp

# Local Claude Code settings (machine-specific; sets a permissive default mode)
.claude/

# Papers and publisher PDFs: cite them in docs/references.md, never commit them (no publishing rights)
docs/refs/
references/
*.pdf
