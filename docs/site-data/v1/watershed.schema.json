{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Watershed conditions",
 "description": "rivers/<slug>/watershed.json: per segment, its HUC8 watershed. A PRISM day ends at 12:00 UTC on its date.",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": 1
  },
  "as_of": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "segments": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "color_index": {
      "type": "integer"
     },
     "huc8": {
      "type": [
       "string",
       "null"
      ]
     },
     "huc4": {
      "type": "string"
     },
     "coverage": {
      "type": "object",
      "properties": {
       "grid_fraction": {
        "type": [
         "number",
         "null"
        ]
       },
       "has_precip": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "note": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "grid_fraction",
       "has_precip",
       "note"
      ],
      "additionalProperties": true
     },
     "precipitation": {
      "type": "object",
      "properties": {
       "months": {
        "type": "array",
        "items": {
         "type": "string",
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
       },
       "total_in": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "normal_in": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "days_counted": {
        "type": "array",
        "items": {
         "type": "integer"
        }
       },
       "complete": {
        "type": "array",
        "items": {
         "type": "boolean"
        }
       }
      },
      "required": [
       "months",
       "total_in",
       "normal_in",
       "days_counted",
       "complete"
      ],
      "additionalProperties": true
     },
     "daily_precipitation": {
      "type": "object",
      "properties": {
       "dates": {
        "type": "array",
        "items": {
         "type": "string",
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
       },
       "inches": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "note": {
        "type": "string"
       }
      },
      "required": [
       "dates",
       "inches",
       "note"
      ],
      "additionalProperties": true
     },
     "recent": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "properties": {
         "window_start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
         },
         "window_end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
         },
         "total_in": {
          "type": [
           "number",
           "null"
          ]
         },
         "normal_in": {
          "type": [
           "number",
           "null"
          ]
         },
         "percent_of_normal": {
          "type": [
           "number",
           "null"
          ]
         },
         "percentile": {
          "type": [
           "number",
           "null"
          ]
         },
         "wettest_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
         },
         "wettest_in": {
          "type": [
           "number",
           "null"
          ]
         }
        },
        "required": [
         "window_start",
         "window_end",
         "total_in",
         "normal_in",
         "percent_of_normal",
         "percentile",
         "wettest_date",
         "wettest_in"
        ],
        "additionalProperties": true
       }
      ]
     },
     "temperature": {
      "type": "object",
      "properties": {
       "months": {
        "type": "array",
        "items": {
         "type": "string",
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
       },
       "anomaly_c": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       }
      },
      "required": [
       "months",
       "anomaly_c"
      ],
      "additionalProperties": true
     },
     "snow": {
      "type": "object",
      "properties": {
       "weeks_of_water_year": {
        "type": "array",
        "items": {
         "type": "integer"
        }
       },
       "median_2004_2025_in": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "winters": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "water_year": {
           "type": "integer"
          },
          "inches": {
           "type": "array",
           "items": {
            "type": [
             "number",
             "null"
            ]
           }
          }
         },
         "required": [
          "water_year",
          "inches"
         ],
         "additionalProperties": true
        }
       }
      },
      "required": [
       "weeks_of_water_year",
       "median_2004_2025_in",
       "winters"
      ],
      "additionalProperties": true
     },
     "drought": {
      "type": "object",
      "properties": {
       "dates": {
        "type": "array",
        "items": {
         "type": "string",
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
       },
       "dsci": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       }
      },
      "required": [
       "dates",
       "dsci"
      ],
      "additionalProperties": true
     }
    },
    "required": [
     "name",
     "color_index",
     "huc8",
     "huc4",
     "coverage",
     "precipitation",
     "daily_precipitation",
     "recent",
     "temperature",
     "snow",
     "drought"
    ],
    "additionalProperties": true
   }
  }
 },
 "required": [
  "schema_version",
  "as_of",
  "segments"
 ],
 "additionalProperties": true
}
