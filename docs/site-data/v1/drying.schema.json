{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Drying",
 "description": "rivers/<slug>/drying.json: days a year any gauge in a segment read below dry_cfs.",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": 1
  },
  "dry_cfs": {
   "type": "number"
  },
  "normally_dry_share": {
   "type": "number"
  },
  "years": {
   "type": "array",
   "items": {
    "type": "integer"
   }
  },
  "as_of": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "baseline": {
   "type": "string"
  },
  "segments": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "color_index": {
      "type": "integer"
     },
     "dry_days": {
      "type": "array",
      "items": {
       "type": [
        "integer",
        "null"
       ]
      }
     },
     "days_with_data": {
      "type": "array",
      "items": {
       "type": [
        "integer",
        "null"
       ]
      }
     },
     "median": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "name",
     "color_index",
     "dry_days",
     "days_with_data",
     "median"
    ],
    "additionalProperties": true
   }
  },
  "left_out": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "segment": {
      "type": "string"
     },
     "gauges": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "segment",
     "gauges"
    ],
    "additionalProperties": true
   }
  }
 },
 "required": [
  "schema_version",
  "dry_cfs",
  "normally_dry_share",
  "years",
  "as_of",
  "baseline",
  "segments",
  "left_out"
 ],
 "additionalProperties": true
}
