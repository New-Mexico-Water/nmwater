{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Bundle manifest",
 "description": "manifest.json: what the bundle holds. Dates are ISO 8601.",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": 1
  },
  "producer": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string"
    },
    "git_sha": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "name",
    "git_sha"
   ],
   "additionalProperties": true
  },
  "generated": {
   "type": "string"
  },
  "data_through": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "site": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string"
    }
   },
   "required": [
    "name"
   ],
   "additionalProperties": true
  },
  "rivers": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
     },
     "name": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "segments": {
      "type": "integer",
      "minimum": 1
     },
     "gauges": {
      "type": "integer",
      "minimum": 0
     },
     "first_year": {
      "type": "integer"
     },
     "last_week": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "tabs": {
      "type": "array",
      "items": {
       "enum": [
        "overview",
        "flow",
        "normal",
        "drying",
        "quality",
        "watershed",
        "notes"
       ]
      }
     },
     "reporting": {
      "type": "boolean"
     },
     "last_52_mean_cfs": {
      "type": [
       "number",
       "null"
      ]
     },
     "segments_rated": {
      "type": "integer",
      "minimum": 0
     },
     "segments_below_normal": {
      "type": "integer",
      "minimum": 0
     },
     "issues_warn": {
      "type": "integer",
      "minimum": 0
     },
     "removed_values": {
      "type": "integer",
      "minimum": 0
     },
     "description": {
      "type": "string"
     },
     "social_image": {
      "type": [
       "string",
       "null"
      ]
     },
     "bytes": {
      "type": "object"
     },
     "generated": {
      "type": "string"
     }
    },
    "required": [
     "slug",
     "name",
     "path",
     "segments",
     "gauges",
     "first_year",
     "last_week",
     "tabs",
     "reporting",
     "last_52_mean_cfs",
     "segments_rated",
     "segments_below_normal",
     "issues_warn",
     "removed_values",
     "description",
     "social_image",
     "bytes",
     "generated"
    ],
    "additionalProperties": true
   }
  },
  "headlines": {
   "type": "object",
   "properties": {
    "rivers": {
     "type": "object",
     "properties": {
      "total": {
       "type": "integer"
      },
      "rated": {
       "type": "integer"
      },
      "with_segment_below_normal": {
       "type": "integer"
      }
     },
     "required": [
      "total",
      "rated",
      "with_segment_below_normal"
     ],
     "additionalProperties": true
    }
   },
   "required": [
    "rivers"
   ],
   "additionalProperties": true
  }
 },
 "required": [
  "schema_version",
  "producer",
  "generated",
  "data_through",
  "site",
  "rivers",
  "headlines"
 ],
 "additionalProperties": true
}
