 "type": "object",
 "properties": {
  "schema_version": {
   "const": 2
  },
  "unit": {
   "type": "string"
  },
  "kind": {
   "enum": [
    "watershed",
    "range"
   ]
  },
  "name": {
   "type": "string"
  },
  "water_year": {
   "type": "integer"
  },
  "model_day": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "day_index": {
   "type": "integer",
   "minimum": 0,
   "maximum": 364
  },
  "stations_day": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "baseline": {
