{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Bundle manifest",
 "description": "manifest.json: what the bundle holds. Dates are ISO 8601.",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": 2
  },
  "producer": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string"
    },
    "git_sha": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "name",
    "git_sha"
   ],
   "additionalProperties": true
  },
  "generated": {
   "type": "string"
  },
  "data_through": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "site": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string"
    }
   },
   "required": [
    "name"
   ],
   "additionalProperties": true
  },
  "rivers": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
     },
     "name": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "segments": {
      "type": "integer",
      "minimum": 1
     },
     "gauges": {
      "type": "integer",
      "minimum": 0
     },
     "first_year": {
      "type": "integer"
     },
     "last_week": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "tabs": {
      "type": "array",
      "items": {
       "enum": [
        "overview",
        "flow",
        "normal",
        "drying",
        "quality",
        "watershed",
        "notes"
       ]
      }
     },
     "reporting": {
      "type": "boolean"
     },
     "last_52_mean_cfs": {
      "type": [
       "number",
       "null"
      ]
     },
     "segments_rated": {
      "type": "integer",
      "minimum": 0
     },
     "segments_below_normal": {
      "type": "integer",
      "minimum": 0
     },
     "issues_warn": {
      "type": "integer",
      "minimum": 0
     },
     "removed_values": {
      "type": "integer",
      "minimum": 0
     },
     "social_image": {
      "type": [
       "string",
       "null"
      ]
     },
     "bytes": {
      "type": "object"
     },
     "generated": {
      "type": "string"
     }
    },
    "required": [
     "slug",
     "name",
     "path",
     "segments",
     "gauges",
     "first_year",
     "last_week",
     "tabs",
     "reporting",
     "last_52_mean_cfs",
     "segments_rated",
     "segments_below_normal",
     "issues_warn",
     "removed_values",
     "social_image",
     "bytes",
     "generated"
    ],
    "additionalProperties": true
   }
  },
  "headlines": {
   "type": "object",
   "properties": {
    "rivers": {
     "type": "object",
     "properties": {
      "total": {
       "type": "integer"
      },
      "rated": {
       "type": "integer"
      },
      "with_segment_below_normal": {
       "type": "integer"
      }
     },
     "required": [
      "total",
      "rated",
      "with_segment_below_normal"
     ],
     "additionalProperties": true
    }
   },
   "required": [
    "rivers"
   ],
   "additionalProperties": true
  },
  "license": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "properties": {
      "spdx": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": "string"
      },
      "attribution": {
       "type": "string"
      },
      "attribution_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "scope": {
       "type": "string"
      },
      "not_covered": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "required": [
      "url",
      "attribution",
      "scope",
      "not_covered"
     ],
     "additionalProperties": true
    }
   ]
  },
  "precipitation": {
   "type": "object",
   "properties": {
    "path": {
     "type": "string"
    },
    "watersheds": {
     "type": "integer"
    },
    "as_of": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "windows": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "files": {
     "type": "object",
     "properties": {
      "index": {
       "type": "string"
      },
      "csv": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "watersheds": {
       "type": "string"
      }
     },
     "required": [
      "index",
      "csv"
     ],
     "additionalProperties": true
    }
   },
   "required": [
    "path",
    "watersheds",
    "as_of",
    "windows",
    "files"
   ],
   "additionalProperties": true
  },
  "geo": {
   "type": "object",
   "properties": {
    "state": {
     "type": "string"
    },
    "county_lines": {
     "type": "string"
    },
    "bounds": {
     "type": "object",
     "properties": {
      "west": {
       "type": "number"
      },
      "south": {
       "type": "number"
      },
      "east": {
       "type": "number"
      },
      "north": {
       "type": "number"
      }
     },
     "required": [
      "west",
      "south",
      "east",
      "north"
     ]
    }
   },
   "required": [
    "state",
    "county_lines",
    "bounds"
   ],
   "additionalProperties": true
  },
  "reservoirs": {
   "type": "object",
   "properties": {
    "path": {
     "type": "string"
    },
    "reservoirs": {
     "type": "integer"
    },
    "as_of": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "files": {
     "type": "object",
     "properties": {
      "index": {
       "type": "string"
      },
      "csv": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "required": [
      "index",
      "csv"
     ],
     "additionalProperties": true
    }
   },
   "required": [
    "path",
    "reservoirs",
    "as_of",
    "files"
   ],
   "additionalProperties": true
  }
 },
 "required": [
  "schema_version",
  "producer",
  "generated",
  "data_through",
  "site",
  "rivers",
  "headlines"
 ],
 "additionalProperties": true
}
