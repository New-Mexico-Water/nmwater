      "type": "string"
     }
    },
    "required": [
     "slug",
     "name"
    ],
    "additionalProperties": true
   }
  },
  "record": {
   "type": "object",
   "properties": {
    "first_date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "years": {
     "type": "integer"
    }
   },
   "required": [
    "first_date",
    "last_date",
    "years"
   ],
   "additionalProperties": true
  },
  "status": {
   "type": "object",
   "properties": {
    "latest_date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "storage_af": {
     "type": "number"
    },
    "capacity_af": {
     "type": [
      "number",
      "null"
     ]
    },
    "percent": {
