{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Reservoir fill",
 "description": "reservoirs/<slug>/fill.json: one reservoir's status, last 365 days, normal for each date, annual history, capacity, provenance and guidance.",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": 2
  },
  "slug": {
   "type": "string"
  },
  "key": {
   "type": "string"
  },
  "name": {
   "type": "string"
  },
  "dam": {
   "type": "object"
  },
  "river": {
   "type": [
    "string",
    "null"
   ]
  },
  "basin": {
   "type": [
    "string",
    "null"
   ]
  },
  "role": {
   "enum": [
    "storage",
    "flood_control",
    "dry_flood",
    "diversion",
    "municipal"
   ]
  },
  "measure": {
   "enum": [
    "percent_full",
    "conservation_pool",
    "flood_pool_use",
    "storage_only"
   ]
  },
  "river_slugs": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "rivers": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "slug": {
      "type": "string"
     },
