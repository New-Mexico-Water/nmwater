      "number",
      "null"
     ]
    },
    "percentile": {
     "type": [
      "number",
      "null"
     ]
    },
    "class": {
     "type": [
      "string",
      "null"
     ]
    },
    "class_floored": {
     "type": "boolean"
    },
    "normal_percent": {
     "type": [
      "number",
      "null"
     ]
    },
    "storage_30_days_ago_af": {
     "type": [
      "number",
      "null"
     ]
    },
    "percent_30_days_ago": {
     "type": [
      "number",
      "null"
     ]
    },
    "storage_year_ago_af": {
     "type": [
      "number",
      "null"
     ]
    },
    "percent_year_ago": {
     "type": [
      "number",
      "null"
     ]
    },
    "capacity_confidence": {
     "type": [
      "string",
      "null"
     ]
    },
    "days_in_flood_storage_this_year": {
     "type": [
      "integer",
      "null"
     ]
    },
    "above_conservation_pool_now": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "last_flood_storage_date": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "latest_date",
    "storage_af",
    "capacity_af",
    "percent",
    "percentile",
    "class",
    "class_floored",
    "normal_percent",
    "storage_30_days_ago_af",
    "percent_30_days_ago",
    "storage_year_ago_af",
    "percent_year_ago",
    "capacity_confidence",
    "days_in_flood_storage_this_year",
