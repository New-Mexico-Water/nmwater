     "items": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "release_af": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "peak_inflow_cfs": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "peak_release_cfs": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     }
